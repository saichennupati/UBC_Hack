# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
MOD_SHARED_SECRET=

# Canonical app origin for wallet verification and the simulator.
# Set to your deployed HTTPS origin on Vercel; no trailing path.
APP_URL=http://localhost:3000

# Optional: search text for the read-only Gemini markets panel (default GTA)
GEMINI_MARKET_SEARCH=
